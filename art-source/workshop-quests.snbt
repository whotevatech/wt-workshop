      ],
      "x": 7.5,
      "y": 2.5
    },
    {
      "id": "60635C65D8377FB2",
      "title": "A Touch of Redstone",
      "description": [
        "Apply redstone in the Tool Station to complete Haste I. Default cost: 16 redstone points and one upgrade slot; a redstone block contributes nine points.",
        "Small batches save partial progress. The station shows the amount consumed and the resulting stats; hover below its table for full details. A completed Haste level also adds a red accent to the tool."
      ],
      "icon": {
        "id": "minecraft:redstone"
      },
      "dependencies": [
