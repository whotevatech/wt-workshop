    {
      "id": "665D74C35742CE3D",
      "title": "A Familiar Tool",
      "description": [
        "Earn tool XP by mining suitable blocks or using a Workshop sword in combat. Reach level 1 on any assembled Workshop tool.",
        "By default each level gives one upgrade slot and 2% mining speed and durability. Levels 5 and 10 also grant one ability slot. Pack configuration can change these values."
      ],
      "icon": {
        "id": "minecraft:experience_bottle"
      },
      "dependencies": [
        "6C1E4EA823CAB4D6"
      ],
