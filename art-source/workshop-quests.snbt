    {
      "id": "67CDAADC44543552",
      "title": "Your First Metal Head",
      "description": [
        "Make or obtain a Pickaxe Head cast and cast a metal pickaxe head. Use the head in the Tool Station to replace the head on an existing pickaxe while preserving its progress.",
        "This task detects ownership of the cast; try the casting and replacement steps yourself."
      ],
