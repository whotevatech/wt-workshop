    },
    {
      "id": "673C94712930649A",
      "title": "From Ingot to Part",
      "description": [
        "Craft the Workshop Smeltery. Add fuel, melt metal, and use casts for metal parts. One ingot equals 90 internal molten units.",
        "Check the casting recipes for each part cost. Gold cast-making consumes its template; finished casts are reusable."
      ],
      "icon": {
        "id": "wt_workshop:smeltery"
      },
